# ============================================================================
# 웨딩버틀러 환경변수
#
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env.local
#
# Vercel 에 배포할 때는 Project Settings → Environment Variables 에 같은
# 이름으로 등록하면 됩니다. .env.local 은 git 에 올라가지 않습니다.
#
# ★ 아무것도 채우지 않아도 사이트는 동작합니다.
#   - 결제는 모의결제 모드로 동작 (실제 결제 없음)
#   - 예약/문의는 안내 문구가 표시됨 (저장은 되지 않음)
# ============================================================================


# ── 사이트 주소 ──────────────────────────────────────────────────────────
# 배포된 도메인. 검색엔진 메타태그와 sitemap 에 쓰입니다.
NEXT_PUBLIC_SITE_URL=https://weddingbutler.vercel.app


# ── 데이터베이스 (Supabase) ──────────────────────────────────────────────
# 1. supabase.com 에서 프로젝트 생성
# 2. SQL Editor 에서 supabase/schema.sql 전체를 실행
# 3. Project Settings → API 에서 아래 두 값을 복사
#
# ⚠️ service_role 키는 모든 보안 규칙을 우회합니다.
#    절대 클라이언트 코드나 공개 저장소에 넣지 마세요.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# ── 결제 (포트원 V2 + 토스페이먼츠) ──────────────────────────────────────
# 1. portone.io 가입 → 토스페이먼츠 계약 신청
# 2. 관리자 콘솔 → 연동 정보 → 채널 관리에서 채널 추가
# 3. 아래 값들을 복사
#
# 이 값들이 비어 있으면 자동으로 모의결제 모드로 동작합니다.
# (실제 결제창 대신 테스트용 확인 창이 열리고, 실제 돈은 빠져나가지 않습니다)
#
# storeId, channelKey 는 브라우저에 노출되어도 되는 값입니다.
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=

# API Secret 은 서버에서만 씁니다. 결제 금액을 검증하는 데 필요합니다.
# 관리자 콘솔 → 결제 연동 → API Keys 에서 발급받습니다.
PORTONE_API_SECRET=

# 웹훅 시크릿. 관리자 콘솔 → 결제 연동 → 웹훅 에서 발급받고,
# 웹훅 URL 로 https://<도메인>/api/payments/webhook 을 등록하세요.
# 모바일 결제 중 이탈했을 때 결제 상태를 맞추는 데 쓰입니다.
PORTONE_WEBHOOK_SECRET=


# ── 관리자 페이지 ────────────────────────────────────────────────────────
# /admin 에서 예약 현황과 문의를 확인할 때 쓰는 비밀번호입니다.
# 충분히 긴 값으로 설정하세요. 비어 있으면 /admin 이 잠깁니다.
ADMIN_PASSWORD=

# (선택) 로그인 세션 서명에 쓰는 키. 비워두면 ADMIN_PASSWORD 에서 파생됩니다.
# 지정해두면 비밀번호를 바꿔도 기존 세션이 유지됩니다.
ADMIN_SESSION_SECRET=
