# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (Settings > API in your Supabase project) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Service role key — server-only, has full DB access. Used exclusively inside
# src/app/api/**/route.ts. Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- PortOne (portone.io dashboard) + Toss Payments channel ---
# Store ID and channel key are public/client-safe (used by the browser SDK).
# Channel key must point at a Toss Payments channel configured in your
# PortOne "결제 연동" settings.
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
# V2 API secret — server-only, used to verify payments after checkout
# (PortOne dashboard > 결제연동 > API Keys > V2 API Secret).
PORTONE_API_SECRET=

# --- 웨딩버틀러 어드민 연동 (optional but recommended) ---
# When set, every submitted reservation is pushed to the admin's
# "신규요청" list right after it's saved to Supabase (before the deposit
# payment step even runs). If unset, reservations still work normally —
# the sync is skipped with a console warning, nothing breaks.
# ADMIN_API_URL is the admin's public intake endpoint, e.g.
# https://admin-weddingbutler-web.vercel.app/api/public/reservations
# ADMIN_API_KEY must match RESERVATION_API_KEY set on that admin project.
ADMIN_API_URL=
ADMIN_API_KEY=

# --- SEO site verification (optional; get these after registering the site) ---
# Google Search Console (Settings > Ownership verification > HTML tag) — copy just the content value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Naver Search Advisor (site verification > HTML tag) — copy just the content value
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
