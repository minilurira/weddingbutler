# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (Settings > API in your Supabase project) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Service role key — server-only, has full DB access. Used exclusively inside
# src/app/api/**/route.ts. Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- PortOne (portone.io dashboard) + KG이니시스 channel ---
# Store ID and channel key are public/client-safe (used by the browser SDK).
# Channel key must point at a KG이니시스 channel configured in your
# PortOne "결제 연동" settings.
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
# V2 API secret — server-only, used to verify payments after checkout
# (PortOne dashboard > 결제연동 > API Keys > V2 API Secret).
PORTONE_API_SECRET=

# --- 결제/알림톡/카카오워크봇 파이프라인 테스트용 (optional) ---
# Set this to any secret string, then open the site with ?testkey=<that value>
# to reveal a hidden "테스트 결제 (1,000원)" button in the header — runs the
# exact same reservation flow as a real booking but charges 1,000원 instead
# of the real package price. Leave unset to disable the feature entirely
# (the button only appears when the URL's testkey matches this value, and
# the server independently re-checks it before charging anything).
TEST_PAYMENT_KEY=

# --- 웨딩버틀러 어드민 연동 (optional but recommended) ---
# When set, a reservation is pushed to the admin's "신규요청" list once the
# deposit payment is confirmed (see /api/reservations/[id]/confirm). If
# unset, reservations still work normally — the sync is skipped with a
# console warning, nothing breaks.
# ADMIN_API_URL is the admin's public intake endpoint, e.g.
# https://admin-weddingbutler-web.vercel.app/api/public/reservations
# ADMIN_API_KEY must match RESERVATION_API_KEY set on that admin project.
ADMIN_API_URL=
ADMIN_API_KEY=
# 고객 축의 기록(/r/[token])도 같은 어드민 주소(ADMIN_API_URL의 도메인)와 키로
# /api/public/records/* 를 부르고, 문자 인증 쿠키·관리자 미리보기 서명을 검증한다.
# 어드민에 RECORD_API_KEY를 따로 정했다면 여기에도 같은 값을 넣는다(비우면 ADMIN_API_KEY 사용).
RECORD_API_KEY=

# --- 배포 승인 게이트 (카카오워크) ---
# scripts/request-approval.mjs → POST /api/approvals sends 승인/거부 buttons to
# a KakaoWork group; the click comes back to /api/approvals/callback.
# Uses a dedicated approval bot, separate from the admin's 신규예약봇
# (a bot has only one Callback URL). Everyone in the conversation can approve.
KAKAOWORK_APPROVAL_APP_KEY=
KAKAOWORK_APPROVAL_CONVERSATION_ID=
# Shared secret between the deploy script and /api/approvals (any long random
# string). The script's shell needs the same value as APPROVAL_API_KEY. If
# unset, the approval endpoints refuse every request.
APPROVAL_API_KEY=

# --- SEO site verification (optional; get these after registering the site) ---
# Google Search Console (Settings > Ownership verification > HTML tag) — copy just the content value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Naver Search Advisor (site verification > HTML tag) — copy just the content value
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
